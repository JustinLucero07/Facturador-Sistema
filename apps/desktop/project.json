{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["web"], "target": "build" }],
      "options": { "command": "node tools/desktop-build.mjs --production", "cwd": "{workspaceRoot}" },
      "outputs": ["{workspaceRoot}/dist/apps/desktop/app"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["node tools/desktop-build.mjs", "env -u ELECTRON_RUN_AS_NODE node_modules/.bin/electron dist/apps/desktop/app"],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node_modules/.bin/electron-builder --config apps/desktop/electron-builder.yml --projectDir apps/desktop", "cwd": "{workspaceRoot}" }
    }
  }
}
