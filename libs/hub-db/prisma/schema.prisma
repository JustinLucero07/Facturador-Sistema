// Esquema del VEKTRA HUB (servidor central de Vektra Systems).
// Clientes, planes, instalaciones y licencias. La facturación/cobro mensual se agrega en la Fase 8.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Personal de Vektra con acceso al panel.
model HubUser {
  id           String    @id @db.Uuid
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name") @db.VarChar(200)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("hub_user")
}

model Plan {
  id           String   @id @db.Uuid
  code         String   @unique @db.VarChar(40)
  name         String   @db.VarChar(80)
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal? @map("price_yearly") @db.Decimal(10, 2)
  /// PlanLimits de @vektra/licensing
  limits       Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  installations Installation[]

  @@map("plan")
}

/// Negocio que compró el sistema (ferretería, bazar...).
model Client {
  id          String   @id @db.Uuid
  ruc         String   @unique @db.VarChar(13)
  legalName   String   @map("legal_name") @db.VarChar(300)
  tradeName   String?  @map("trade_name") @db.VarChar(300)
  contactName String?  @map("contact_name") @db.VarChar(200)
  email       String?  @db.VarChar(254)
  phone       String?  @db.VarChar(30)
  city        String?  @db.VarChar(80)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  installations Installation[]

  @@map("client")
}

enum InstallationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("installation_status")
}

/// Una VPS del cliente con el sistema instalado.
model Installation {
  id              String             @id @db.Uuid
  clientId        String             @map("client_id") @db.Uuid
  planId          String             @map("plan_id") @db.Uuid
  name            String             @db.VarChar(120)
  /// Valor de INSTALLATION_ID en la instancia
  publicId        String             @unique @map("public_id") @db.VarChar(64)
  /// SHA-256 de INSTALLATION_SECRET (alta entropía)
  secretHash      String             @map("secret_hash") @db.VarChar(64)
  baseUrl         String?            @map("base_url") @db.VarChar(300)
  status          InstallationStatus @default(ACTIVE)
  /// Horas de tolerancia sin validar (por defecto 48)
  graceHours      Int                @default(48) @map("grace_hours")
  /// Límites específicos que reemplazan los del plan (opcional)
  limitOverrides  Json?              @map("limit_overrides")
  lastSeenAt      DateTime?          @map("last_seen_at") @db.Timestamptz(3)
  lastIp          String?            @map("last_ip") @db.VarChar(64)
  appVersion      String?            @map("app_version") @db.VarChar(40)
  /// Último reporte de uso/telemetría de la instancia
  lastReport      Json?              @map("last_report")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  client   Client         @relation(fields: [clientId], references: [id])
  plan     Plan           @relation(fields: [planId], references: [id])
  licenses LicenseIssue[]

  @@map("installation")
}

/// Bitácora de licencias emitidas (periódicas y códigos offline).
model LicenseIssue {
  id             String   @id @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  kind           String   @db.VarChar(20)
  status         String   @db.VarChar(20)
  issuedAt       DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  issuedBy       String?  @map("issued_by") @db.Uuid

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId, issuedAt(sort: Desc)])
  @@map("license_issue")
}
