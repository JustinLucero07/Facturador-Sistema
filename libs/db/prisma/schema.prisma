// Esquema de la INSTANCIA (VPS de cada cliente). Fase 0: plataforma, seguridad y estructura SRI.
// Convenciones:
//  - Tablas con `tenant_id` tienen Row Level Security (ver migración `rls`).
//  - IDs UUID generados por la app (uuidv7) para permitir creación offline.
//  - Nombres en BD en snake_case.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Plataforma ─────────────────────────

enum TaxRegime {
  GENERAL
  RIMPE_EMPRENDEDOR
  RIMPE_NEGOCIO_POPULAR

  @@map("tax_regime")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

/// Empresa (un RUC). Una instancia puede tener varias del mismo dueño.
model Tenant {
  id                     String       @id @db.Uuid
  ruc                    String       @unique @db.VarChar(13)
  legalName              String       @map("legal_name") @db.VarChar(300)
  tradeName              String?      @map("trade_name") @db.VarChar(300)
  mainAddress            String       @map("main_address") @db.VarChar(300)
  taxRegime              TaxRegime    @default(GENERAL) @map("tax_regime")
  /// 1 = pruebas, 2 = producción (SRI)
  environment            Int          @default(1) @db.SmallInt
  keepsAccounting        Boolean      @default(false) @map("keeps_accounting")
  specialTaxpayerNumber  String?      @map("special_taxpayer_number") @db.VarChar(13)
  withholdingAgentNumber String?      @map("withholding_agent_number") @db.VarChar(8)
  businessTemplate       String       @default("general") @map("business_template") @db.VarChar(40)
  status                 TenantStatus @default(ACTIVE)
  /// Configuración general (stock negativo, decimales, etc.)
  settings               Json         @default("{}")
  /// Logo, colores para RIDE/tickets/correos
  branding               Json         @default("{}")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  modules         TenantModule[]
  memberships     Membership[]
  roles           Role[]
  establishments  Establishment[]
  emissionPoints  EmissionPoint[]
  warehouses      Warehouse[]
  devices         Device[]
  sequenceCounter SequenceCounter[]
  auditLogs       AuditLog[]
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]
  certificates    Certificate[]
  mailConfig      MailConfig?
  documents       Document[]

  @@map("tenant")
}

model TenantModule {
  tenantId   String   @map("tenant_id") @db.Uuid
  moduleCode String   @map("module_code") @db.VarChar(40)
  enabled    Boolean  @default(true)
  settings   Json     @default("{}")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleCode])
  @@map("tenant_module")
}

/// Licencia vigente de la instancia (fila única id = 1), emitida por el Vektra Hub.
model InstanceLicense {
  id              Int       @id @default(1) @db.SmallInt
  installationId  String    @map("installation_id") @db.VarChar(64)
  token           String?
  status          String    @default("unknown") @db.VarChar(20)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  lastValidatedAt DateTime? @map("last_validated_at") @db.Timestamptz(3)
  lastError       String?   @map("last_error")
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("instance_license")
}

// ───────────────────────── Seguridad ─────────────────────────

/// Usuario de la instancia. Accede a una o varias empresas mediante Membership.
model User {
  id             String    @id @db.Uuid
  email          String    @unique @db.VarChar(254)
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name") @db.VarChar(200)
  /// Técnico de Soporte Vektra: acceso a todas las empresas con todos los permisos.
  isSupport      Boolean   @default(false) @map("is_support")
  active         Boolean   @default(true)
  totpSecretEnc  String?   @map("totp_secret_enc")
  totpEnabled    Boolean   @default(false) @map("totp_enabled")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Se incrementa al cambiar contraseña / desactivar: invalida accesos emitidos.
  tokenVersion   Int       @default(0) @map("token_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("app_user")
}

model Membership {
  id                     String   @id @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  active                 Boolean  @default(true)
  defaultEstablishmentId String?  @map("default_establishment_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("membership")
}

model Role {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  /// Rol creado por el sistema (Administrador, Cajero...). Se puede editar, no eliminar.
  isSystem    Boolean  @default(false) @map("is_system")
  systemCode  String?  @map("system_code") @db.VarChar(40)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, name])
  @@map("role")
}

/// Catálogo global de permisos (sembrado desde código).
model Permission {
  code        String @id @db.VarChar(60)
  module      String @db.VarChar(40)
  description String @db.VarChar(200)

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  tenantId       String @map("tenant_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code") @db.VarChar(60)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

model MembershipRole {
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_role")
}

model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// Todos los tokens de una misma sesión comparten familia; si se reutiliza uno ya rotado se revoca la familia.
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent") @db.VarChar(300)
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_token")
}

model AuditLog {
  id       String   @id @db.Uuid
  tenantId String?  @map("tenant_id") @db.Uuid
  userId   String?  @map("user_id") @db.Uuid
  action   String   @db.VarChar(40)
  entity   String   @db.VarChar(60)
  entityId String?  @map("entity_id") @db.VarChar(64)
  before   Json?
  after    Json?
  ip       String?  @db.VarChar(64)
  at       DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, at(sort: Desc)])
  @@index([tenantId, entity, entityId])
  @@map("audit_log")
}

// ───────────────────────── Estructura SRI ─────────────────────────

model Establishment {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Código de 3 dígitos (001)
  code      String   @db.Char(3)
  name      String   @db.VarChar(200)
  address   String   @db.VarChar(300)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emissionPoints EmissionPoint[]
  warehouses     Warehouse[]
  documents      Document[]

  @@unique([tenantId, code])
  @@map("establishment")
}

enum EmissionPointKind {
  WEB
  DESKTOP

  @@map("emission_point_kind")
}

model EmissionPoint {
  id              String            @id @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  establishmentId String            @map("establishment_id") @db.Uuid
  /// Código de 3 dígitos (001)
  code            String            @db.Char(3)
  name            String            @db.VarChar(120)
  /// DESKTOP: el secuencial lo controla exclusivamente la caja dueña (modo offline).
  kind            EmissionPointKind @default(WEB)
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  establishment Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  sequences     SequenceCounter[]
  device        Device?
  documents     Document[]

  @@unique([establishmentId, code])
  @@map("emission_point")
}

/// Próximo secuencial por punto de emisión y tipo de comprobante (01, 03, 04, 05, 06, 07).
model SequenceCounter {
  tenantId        String   @map("tenant_id") @db.Uuid
  emissionPointId String   @map("emission_point_id") @db.Uuid
  docType         String   @map("doc_type") @db.Char(2)
  nextValue       BigInt   @default(1) @map("next_value")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emissionPoint EmissionPoint @relation(fields: [emissionPointId], references: [id], onDelete: Cascade)

  @@id([emissionPointId, docType])
  @@map("sequence_counter")
}

model Warehouse {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String   @db.VarChar(120)
  isDefault       Boolean  @default(false) @map("is_default")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  stock         Stock[]
  movements     InventoryMovement[]

  @@unique([establishmentId, name])
  @@map("warehouse")
}

/// Caja de escritorio (Electron). Dueña exclusiva de un punto de emisión.
model Device {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  emissionPointId String    @unique @map("emission_point_id") @db.Uuid
  name            String    @db.VarChar(120)
  fingerprint     String?   @db.VarChar(128)
  /// pending (esperando vinculación) | active | revoked
  status          String    @default("pending") @db.VarChar(20)
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(3)
  /// SHA-256 del token de la caja (el token solo lo conoce la caja)
  tokenHash        String?   @unique @map("token_hash") @db.Char(64)
  /// SHA-256 del código de vinculación de un solo uso
  pairingCodeHash  String?   @unique @map("pairing_code_hash") @db.Char(64)
  pairingExpiresAt DateTime? @map("pairing_expires_at") @db.Timestamptz(3)
  appVersion       String?   @map("app_version") @db.VarChar(40)
  lastSyncAt       DateTime? @map("last_sync_at") @db.Timestamptz(3)
  /// Operaciones que la caja reportó como pendientes / con error en su última sincronización
  pendingOps       Int       @default(0) @map("pending_ops")
  failedOps        Int       @default(0) @map("failed_ops")
  createdBy        String?   @map("created_by") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emissionPoint EmissionPoint @relation(fields: [emissionPointId], references: [id], onDelete: Cascade)
  syncOps       SyncOp[]

  @@map("device")
}

/// Operación recibida de una caja de escritorio (idempotencia y bitácora de sincronización).
model SyncOp {
  /// Id generado en la caja (uuidv7): reenviar la misma operación no la aplica dos veces
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  deviceId    String   @map("device_id") @db.Uuid
  type        String   @db.VarChar(40)
  /// APPLIED | REJECTED
  status      String   @db.VarChar(20)
  message     String?
  payload     Json
  result      Json?
  /// Hora en la caja cuando se hizo la operación
  clientAt    DateTime @map("client_at") @db.Timestamptz(3)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, processedAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("sync_op")
}

// ───────────────────────── Configuración tributaria (global, Fase 1) ─────────────────────────
// Fuente: Ficha Técnica offline del SRI v2.34. Valores editables: nunca fijos en el código.

/// Tarifas de impuestos (Tabla 16 impuestos, Tabla 17 tarifas de IVA).
model TaxRate {
  id             String    @id @db.Uuid
  /// 2 IVA, 3 ICE, 5 IRBPNR
  taxCode        String    @map("tax_code") @db.VarChar(2)
  /// codigoPorcentaje del XML
  percentageCode String    @map("percentage_code") @db.VarChar(4)
  name           String    @db.VarChar(80)
  /// Etiqueta corta para RIDE y tickets ("15%", "NO OBJETO DE IVA")
  label          String    @db.VarChar(40)
  rate           Decimal   @db.Decimal(6, 2)
  validFrom      DateTime? @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  active         Boolean   @default(true)
  sortOrder      Int       @default(0) @map("sort_order")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([taxCode, percentageCode, validFrom])
  @@map("tax_rate")
}

/// Catálogos del SRI: formas de pago (Tabla 24), tipos de identificación (Tabla 6), tipos de comprobante (Tabla 3).
model SriCatalog {
  catalog     String  @db.VarChar(40)
  code        String  @db.VarChar(10)
  description String  @db.VarChar(200)
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  @@id([catalog, code])
  @@map("sri_catalog")
}

/// Parámetros del SRI (URLs de web services, límite consumidor final, leyendas, versiones XML…).
model SriSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  note      String?  @db.VarChar(300)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sri_setting")
}

// ───────────────────────── Firma electrónica y correo (por empresa) ─────────────────────────

model Certificate {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// .p12 cifrado (AES-256-GCM con MASTER_KEY), nunca expuesto al frontend
  p12Enc       String   @map("p12_enc")
  passwordEnc  String   @map("password_enc")
  subject      String   @db.VarChar(500)
  issuer       String   @db.VarChar(500)
  serialNumber String   @map("serial_number") @db.VarChar(80)
  holderName   String   @map("holder_name") @db.VarChar(300)
  validFrom    DateTime @map("valid_from") @db.Timestamptz(3)
  validTo      DateTime @map("valid_to") @db.Timestamptz(3)
  active       Boolean  @default(true)
  /// Avisos de caducidad ya enviados (30, 15, 5 días)
  alertsSent   Json     @default("[]") @map("alerts_sent")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("certificate")
}

model MailConfig {
  tenantId    String   @id @map("tenant_id") @db.Uuid
  host        String   @db.VarChar(200)
  port        Int
  secure      Boolean  @default(false)
  username    String?  @db.VarChar(200)
  passwordEnc String?  @map("password_enc")
  fromName    String   @map("from_name") @db.VarChar(200)
  fromEmail   String   @map("from_email") @db.VarChar(254)
  replyTo     String?  @map("reply_to") @db.VarChar(254)
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("mail_config")
}

// ───────────────────────── Comprobantes ─────────────────────────

enum DocumentStatus {
  ISSUED
  VOIDED

  @@map("document_status")
}

/// Documento comercial (factura, NC, ND…). Su ciclo de vida en el SRI está en ElectronicDocument.
model Document {
  id              String         @id @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  /// Tabla 3: 01 factura, 03 liquidación, 04 NC, 05 ND, 06 guía, 07 retención
  docType         String         @map("doc_type") @db.Char(2)
  establishmentId String         @map("establishment_id") @db.Uuid
  emissionPointId String         @map("emission_point_id") @db.Uuid
  sequential      BigInt
  issueDate       DateTime       @map("issue_date") @db.Date
  buyerIdType     String         @map("buyer_id_type") @db.Char(2)
  buyerId         String         @map("buyer_id") @db.VarChar(20)
  buyerName       String         @map("buyer_name") @db.VarChar(300)
  buyerAddress    String?        @map("buyer_address") @db.VarChar(300)
  buyerEmail      String?        @map("buyer_email") @db.VarChar(300)
  buyerPhone      String?        @map("buyer_phone") @db.VarChar(30)
  subtotal        Decimal        @db.Decimal(14, 2)
  totalDiscount   Decimal        @map("total_discount") @db.Decimal(14, 2)
  totalTax        Decimal        @map("total_tax") @db.Decimal(14, 2)
  tip             Decimal        @default(0) @db.Decimal(14, 2)
  total           Decimal        @db.Decimal(14, 2)
  /// Agrupación de impuestos calculada (base/valor por tarifa)
  taxSummary      Json           @map("tax_summary")
  additionalInfo  Json           @default("[]") @map("additional_info")
  status          DocumentStatus @default(ISSUED)
  /// Caja (sesión) en la que se hizo la venta (POS)
  cashSessionId   String?        @map("cash_session_id") @db.Uuid
  /// Emitido sin conexión por una caja de escritorio (Fase 4)
  deviceId        String?        @map("device_id") @db.Uuid
  createdBy       String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  establishment   Establishment       @relation(fields: [establishmentId], references: [id])
  emissionPoint   EmissionPoint       @relation(fields: [emissionPointId], references: [id])
  lines           DocumentLine[]
  payments        DocumentPayment[]
  electronic      ElectronicDocument?

  @@unique([emissionPointId, docType, sequential])
  @@index([cashSessionId])
  @@index([tenantId, issueDate(sort: Desc)])
  @@index([tenantId, buyerId])
  @@map("document")
}

model DocumentLine {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  lineNo      Int      @map("line_no")
  productId   String?  @map("product_id") @db.Uuid
  /// Unidad vendida (caja, metro…) y su factor respecto a la unidad base del producto
  productUnitId String? @map("product_unit_id") @db.Uuid
  unitFactor  Decimal  @default(1) @map("unit_factor") @db.Decimal(18, 6)
  mainCode    String?  @map("main_code") @db.VarChar(25)
  auxCode     String?  @map("aux_code") @db.VarChar(25)
  description String   @db.VarChar(300)
  unit        String?  @db.VarChar(50)
  quantity    Decimal  @db.Decimal(18, 6)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 6)
  discount    Decimal  @db.Decimal(14, 2)
  subtotal    Decimal  @db.Decimal(14, 2)
  additional  Json     @default("[]")

  document Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  taxes    DocumentLineTax[]

  @@unique([documentId, lineNo])
  @@map("document_line")
}

/// Impuesto congelado al momento de la venta (si la tarifa cambia luego, el documento no cambia).
model DocumentLineTax {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  lineId         String  @map("line_id") @db.Uuid
  taxRateId      String? @map("tax_rate_id") @db.Uuid
  taxCode        String  @map("tax_code") @db.VarChar(2)
  percentageCode String  @map("percentage_code") @db.VarChar(4)
  rate           Decimal @db.Decimal(6, 2)
  base           Decimal @db.Decimal(14, 2)
  amount         Decimal @db.Decimal(14, 2)

  line DocumentLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@map("document_line_tax")
}

model DocumentPayment {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  documentId String  @map("document_id") @db.Uuid
  /// Tabla 24: formas de pago del SRI
  sriCode    String  @map("sri_code") @db.Char(2)
  /// Medio interno: efectivo, tarjeta, transferencia, deuna, payphone, credito…
  method     String  @db.VarChar(30)
  amount     Decimal @db.Decimal(14, 2)
  term       Int?
  timeUnit   String? @map("time_unit") @db.VarChar(10)
  reference  String? @db.VarChar(100)
  /// Efectivo entregado por el cliente (para imprimir el vuelto)
  cashReceived Decimal? @map("cash_received") @db.Decimal(14, 2)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_payment")
}

enum EDocStatus {
  DRAFT
  SIGNED
  SENT
  RECEIVED
  RETURNED
  AUTHORIZED
  NOT_AUTHORIZED
  CONTINGENCY

  @@map("edoc_status")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED

  @@map("email_status")
}

/// Ciclo de vida del comprobante en el SRI (1:1 con Document).
model ElectronicDocument {
  documentId          String      @id @map("document_id") @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  accessKey           String      @unique @map("access_key") @db.Char(49)
  environment         Int         @db.SmallInt
  docType             String      @map("doc_type") @db.Char(2)
  xmlVersion          String      @map("xml_version") @db.VarChar(10)
  status              EDocStatus  @default(DRAFT)
  signedXml           String?     @map("signed_xml")
  authorizedXml       String?     @map("authorized_xml")
  authorizationNumber String?     @map("authorization_number") @db.VarChar(49)
  authorizedAt        DateTime?   @map("authorized_at") @db.Timestamptz(3)
  attempts            Int         @default(0)
  lastAttemptAt       DateTime?   @map("last_attempt_at") @db.Timestamptz(3)
  lastMessages        Json        @default("[]") @map("last_messages")
  emailStatus         EmailStatus @default(PENDING) @map("email_status")
  emailSentAt         DateTime?   @map("email_sent_at") @db.Timestamptz(3)
  emailError          String?     @map("email_error")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  document Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  events   ElectronicDocumentEvent[]

  @@index([tenantId, status])
  @@map("electronic_document")
}

model ElectronicDocumentEvent {
  id         String      @id @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  documentId String      @map("document_id") @db.Uuid
  fromStatus EDocStatus? @map("from_status")
  toStatus   EDocStatus  @map("to_status")
  /// Mensajes del SRI o error técnico
  messages   Json        @default("[]")
  note       String?
  at         DateTime    @default(now()) @db.Timestamptz(3)

  electronic ElectronicDocument @relation(fields: [documentId], references: [documentId], onDelete: Cascade)

  @@index([documentId, at])
  @@map("electronic_document_event")
}

// ───────────────────────── Catálogo de productos (Fase 2) ─────────────────────────
// tenant_id sin relación declarada hacia Tenant: el aislamiento lo garantiza RLS.

model Unit {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  code          String   @db.VarChar(20)
  name          String   @db.VarChar(60)
  /// Permite cantidades con decimales (kilo, metro, litro)
  allowsDecimal Boolean  @default(false) @map("allows_decimal")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, code])
  @@map("unit")
}

model Category {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(120)
  parentId  String?  @map("parent_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  products Product[]

  @@unique([tenantId, name])
  @@map("category")
}

model Brand {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  products Product[]

  @@unique([tenantId, name])
  @@map("brand")
}

model PriceList {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(20)
  name      String   @db.VarChar(80)
  isDefault Boolean  @default(false) @map("is_default")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  prices ProductPrice[]

  @@unique([tenantId, code])
  @@map("price_list")
}

model Product {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  code         String    @db.VarChar(25)
  name         String    @db.VarChar(300)
  description  String?
  categoryId   String?   @map("category_id") @db.Uuid
  brandId      String?   @map("brand_id") @db.Uuid
  /// Unidad base (en la que se lleva el stock y el kárdex)
  unitId       String    @map("unit_id") @db.Uuid
  /// Tarifa de IVA (tabla global tax_rate)
  taxRateId    String    @map("tax_rate_id") @db.Uuid
  /// codigoAuxiliar del XML (p. ej. códigos de materiales de construcción, Anexo 23)
  auxCode      String?   @map("aux_code") @db.VarChar(25)
  /// Servicio: no lleva stock
  isService    Boolean   @default(false) @map("is_service")
  /// Costo promedio ponderado (unidad base)
  avgCost      Decimal   @default(0) @map("avg_cost") @db.Decimal(18, 6)
  lastCost     Decimal   @default(0) @map("last_cost") @db.Decimal(18, 6)
  minStock     Decimal   @default(0) @map("min_stock") @db.Decimal(18, 6)
  imageUrl     String?   @map("image_url")
  customFields Json      @default("{}") @map("custom_fields")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  category  Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand     Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  units     ProductUnit[]
  barcodes  ProductBarcode[]
  prices    ProductPrice[]
  stock     Stock[]
  movements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("product")
}

/// Presentaciones y conversiones: "CAJA" = 12 unidades base. La unidad base tiene factor 1.
model ProductUnit {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  unitId    String  @map("unit_id") @db.Uuid
  factor    Decimal @db.Decimal(18, 6)
  isBase    Boolean @default(false) @map("is_base")

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices   ProductPrice[]
  barcodes ProductBarcode[]

  @@unique([productId, unitId])
  @@map("product_unit")
}

model ProductBarcode {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  /// Presentación que se vende al escanear este código (null = unidad base)
  productUnitId String? @map("product_unit_id") @db.Uuid
  barcode       String  @db.VarChar(64)

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: Cascade)

  @@unique([tenantId, barcode])
  @@map("product_barcode")
}

/// Precio SIN IVA (como viaja en el XML) por lista y presentación.
model ProductPrice {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  priceListId   String  @map("price_list_id") @db.Uuid
  productUnitId String  @map("product_unit_id") @db.Uuid
  price         Decimal @db.Decimal(18, 6)

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceList   PriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productUnitId])
  @@map("product_price")
}

// ───────────────────────── Clientes y proveedores ─────────────────────────

model Party {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// Tabla 6 SRI: 04 RUC, 05 cédula, 06 pasaporte, 08 exterior
  idType         String   @map("id_type") @db.Char(2)
  identification String   @db.VarChar(20)
  name           String   @db.VarChar(300)
  tradeName      String?  @map("trade_name") @db.VarChar(300)
  email          String?  @db.VarChar(300)
  phone          String?  @db.VarChar(30)
  address        String?  @db.VarChar(300)
  isCustomer     Boolean  @default(true) @map("is_customer")
  isSupplier     Boolean  @default(false) @map("is_supplier")
  priceListId    String?  @map("price_list_id") @db.Uuid
  creditLimit    Decimal  @default(0) @map("credit_limit") @db.Decimal(14, 2)
  creditDays     Int      @default(0) @map("credit_days")
  notes          String?
  customFields   Json     @default("{}") @map("custom_fields")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, identification])
  @@index([tenantId, name])
  @@map("party")
}

// ───────────────────────── Inventario ─────────────────────────

model Stock {
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([warehouseId, productId])
  @@index([tenantId, productId])
  @@map("stock")
}

enum MovementType {
  INITIAL
  PURCHASE
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT

  @@map("movement_type")
}

/// Kárdex: cada entrada/salida en unidades base con su costo.
model InventoryMovement {
  id           String       @id @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  warehouseId  String       @map("warehouse_id") @db.Uuid
  type         MovementType
  /// Positiva = entrada, negativa = salida (unidades base)
  quantity     Decimal      @db.Decimal(18, 6)
  unitCost     Decimal      @map("unit_cost") @db.Decimal(18, 6)
  totalCost    Decimal      @map("total_cost") @db.Decimal(18, 6)
  /// Costo promedio del producto después del movimiento
  avgCostAfter Decimal      @map("avg_cost_after") @db.Decimal(18, 6)
  /// Saldo en la bodega después del movimiento
  balanceAfter Decimal      @map("balance_after") @db.Decimal(18, 6)
  documentId   String?      @map("document_id") @db.Uuid
  /// Agrupa los dos lados de una transferencia o un ajuste de varias líneas
  batchId      String?      @map("batch_id") @db.Uuid
  reason       String?      @db.VarChar(300)
  createdBy    String?      @map("created_by") @db.Uuid
  at           DateTime     @default(now()) @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, at])
  @@index([warehouseId, productId, at])
  @@map("inventory_movement")
}

// ───────────────────────── Importación masiva ─────────────────────────

model ImportJob {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// products | parties | initial_stock
  kind       String    @db.VarChar(30)
  status     String    @default("PREVIEW") @db.VarChar(20)
  fileName   String    @map("file_name") @db.VarChar(300)
  total      Int       @default(0)
  validCount Int       @default(0) @map("valid_count")
  errors     Json      @default("[]")
  /// Filas válidas normalizadas, listas para confirmar
  rows       Json      @default("[]")
  result     Json?
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  committedAt DateTime? @map("committed_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("import_job")
}

// ───────────────────────── Caja (Fase 3) ─────────────────────────

enum CashSessionStatus {
  OPEN
  CLOSED

  @@map("cash_session_status")
}

/// Turno de caja de un punto de emisión: apertura → ventas y movimientos → arqueo y cierre.
model CashSession {
  id              String            @id @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  emissionPointId String            @map("emission_point_id") @db.Uuid
  status          CashSessionStatus @default(OPEN)
  openedBy        String            @map("opened_by") @db.Uuid
  openedAt        DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  openingAmount   Decimal           @map("opening_amount") @db.Decimal(14, 2)
  closedBy        String?           @map("closed_by") @db.Uuid
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz(3)
  /// Esperado por forma de pago al cerrar (calculado)
  expected        Json?
  /// Contado por forma de pago (arqueo)
  counted         Json?
  /// Conteo de billetes y monedas (opcional)
  denominations   Json?
  difference      Decimal?          @db.Decimal(14, 2)
  notes           String?

  movements CashMovement[]

  @@index([tenantId, openedAt(sort: Desc)])
  @@map("cash_session")
}

model CashMovement {
  id        String      @id @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  /// IN = ingreso de efectivo, OUT = egreso (pago a proveedor, retiro…)
  type      String      @db.VarChar(3)
  amount    Decimal     @db.Decimal(14, 2)
  reason    String      @db.VarChar(300)
  createdBy String      @map("created_by") @db.Uuid
  at        DateTime    @default(now()) @db.Timestamptz(3)

  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("cash_movement")
}

// ───────────────────────── Proformas ─────────────────────────

/// Proforma / cotización. No es comprobante del SRI; se convierte en factura desde el POS.
model Quote {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  emissionPointId String    @map("emission_point_id") @db.Uuid
  number          BigInt
  buyerIdType     String    @map("buyer_id_type") @db.Char(2)
  buyerId         String    @map("buyer_id") @db.VarChar(20)
  buyerName       String    @map("buyer_name") @db.VarChar(300)
  buyerEmail      String?   @map("buyer_email") @db.VarChar(300)
  priceListId     String?   @map("price_list_id") @db.Uuid
  /// Líneas tal como estaban en el carrito
  lines           Json
  total           Decimal   @db.Decimal(14, 2)
  validUntil      DateTime  @map("valid_until") @db.Date
  notes           String?
  /// Factura en la que se convirtió
  documentId      String?   @map("document_id") @db.Uuid
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([emissionPointId, number])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("quote")
}
