# ───── Instancia (VPS del cliente) ─────
# Solo producción (docker-compose.yml): contraseñas de Postgres y puerto público.
POSTGRES_PASSWORD=
VEKTRA_APP_PASSWORD=
WEB_PORT=80
NODE_ENV=development
TZ=America/Guayaquil

# Usuario dueño del esquema: SOLO para migraciones y seed.
DATABASE_OWNER_URL=postgresql://vektra:vektra_dev@127.0.0.1:5440/vektra
# Usuario de la aplicación (sin BYPASSRLS): api y worker.
DATABASE_URL=postgresql://vektra_app:vektra_app_dev@127.0.0.1:5440/vektra
REDIS_URL=redis://127.0.0.1:6390

API_PORT=3300
WEB_ORIGIN=http://localhost:4300

# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambie-esto-por-un-secreto-largo-de-al-menos-32-caracteres
# Llave maestra AES-256 (32 bytes en base64) para cifrar secretos 2FA, firmas .p12, SMTP, etc.
# Generar con: openssl rand -base64 32
MASTER_KEY=

# Seguridad de login
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Licencia (Vektra Hub)
HUB_URL=http://localhost:3400
INSTALLATION_ID=
INSTALLATION_SECRET=
# Llave pública Ed25519 del Hub (PEM en una línea con \n)
LICENSE_PUBLIC_KEY=

# Usuario inicial de Soporte Vektra (solo seed)
SEED_SUPPORT_EMAIL=soporte@vektra.local
SEED_SUPPORT_PASSWORD=

# ───── Vektra Hub ─────
HUB_DATABASE_OWNER_URL=postgresql://vektra:vektra_dev@127.0.0.1:5440/vektra_hub
HUB_DATABASE_URL=postgresql://vektra_app:vektra_app_dev@127.0.0.1:5440/vektra_hub
HUB_PORT=3400
HUB_PUBLIC_URL=http://localhost:3400
HUB_WEB_ORIGIN=http://localhost:4400
HUB_JWT_SECRET=
# Llave privada Ed25519 del Hub (PEM en una línea con \n). Generar con: pnpm keys:license
LICENSE_PRIVATE_KEY=
HUB_SEED_ADMIN_EMAIL=admin@vektra.local
HUB_SEED_ADMIN_PASSWORD=
